# Copy to .env for local development. Never commit .env.
# Production values are set in the hosting provider's environment settings.

# --- App -------------------------------------------------------------
# Public URL of the app. Used for auth callbacks and the links inside QR codes.
APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------
# Postgres connection string. Local: a local Postgres. Production: the Neon pooled connection string.
DATABASE_URL=postgres://app:app@localhost:5432/ap_grader

# --- Auth ------------------------------------------------------------
# Random string, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-chars
# Google OAuth client (Google Cloud console > APIs and Services > Credentials).
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email and password sign-in for local development and automated tests. Refused when APP_URL is a public https address.
ENABLE_DEV_LOGIN=true

# --- File storage ----------------------------------------------------
# "local" stores files under LOCAL_STORAGE_DIR. "s3" uses the bucket below.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
# S3 bucket for page photos and PDFs (private, SSE-KMS). Credentials come from the
# standard AWS variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) or the host's IAM role.
S3_BUCKET=
S3_REGION=
# Optional KMS key for server-side encryption. Empty uses the bucket's default key.
S3_KMS_KEY_ID=

# --- Models ----------------------------------------------------------
# "fake" returns canned transcriptions and scores (no API key needed). "anthropic" calls the Claude API.
MODEL_MODE=fake
ANTHROPIC_API_KEY=
# Model IDs. Defaults: Haiku 5.5 transcribes, Sonnet 5.5 retries hard pages and scores.
TRANSCRIBE_MODEL=claude-haiku-5-5
TRANSCRIBE_RETRY_MODEL=claude-sonnet-5-5
SCORING_MODEL=claude-sonnet-5-5
# Thinking effort for scoring calls: low, medium or high.
SCORING_EFFORT=medium
# Pages with mean word confidence below this are transcribed again with the retry model.
TRANSCRIBE_RETRY_THRESHOLD=0.8

# --- Background jobs -------------------------------------------------
# "inline" runs jobs inside the web process (local dev and tests). "inngest" uses Inngest.
JOBS_DRIVER=inline
# From the Inngest dashboard, when JOBS_DRIVER=inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
