# Copy to .env for local development. Never commit .env.
# Production values are set in the hosting provider's environment settings.

# --- App -------------------------------------------------------------
# Public URL of the app. Used for auth callbacks and the links inside QR codes.
APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------
# Postgres connection string. Local: a local Postgres. Production: the Neon pooled connection string.
DATABASE_URL=postgres://app:app@localhost:5432/ap_grader

# --- Auth ------------------------------------------------------------
# Random string, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-chars
# Google OAuth client (Google Cloud console > APIs and Services > Credentials).
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email and password sign-in for local development and automated tests. Refused when APP_URL is a public https address.
ENABLE_DEV_LOGIN=true

# --- File storage ----------------------------------------------------
# "local" stores files under LOCAL_STORAGE_DIR. "s3" uses the bucket below.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
# S3 bucket for page photos and PDFs (private, SSE-KMS). Credentials come from the
# standard AWS variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) or the host's IAM role.
S3_BUCKET=
S3_REGION=
# Optional KMS key for server-side encryption. Empty uses the bucket's default key.
S3_KMS_KEY_ID=

# --- Models ----------------------------------------------------------
# "fake" returns canned transcriptions and scores (no API key needed). "anthropic" calls the Claude API.
MODEL_MODE=fake
ANTHROPIC_API_KEY=
# Model IDs. Defaults: Haiku 5.5 transcribes, Sonnet 5.5 retries hard pages and scores.
TRANSCRIBE_MODEL=claude-haiku-5-5
TRANSCRIBE_RETRY_MODEL=claude-sonnet-5-5
SCORING_MODEL=claude-sonnet-5-5
# Thinking effort for scoring calls: low, medium or high.
SCORING_EFFORT=medium
# Pages with mean word confidence below this are transcribed again with the retry model.
TRANSCRIBE_RETRY_THRESHOLD=0.8

# --- Model provider and local worker ---------------------------------
# Every model call goes through src/lib/llm. Background jobs (reading pages, scoring teacher
# essays) can run on your own computer through the local worker (worker/, see the README).
# Nothing changes until LLM_WORKER_TOKEN is set: without it every job runs in the cloud.

# Who answers live calls from this server: "anthropic" (Claude) or "openai" (any
# OpenAI-compatible server). A deployed site cannot point at a localhost server.
LLM_PROVIDER=anthropic
# Who answers when LLM_PROVIDER fails or times out: anthropic, openai or none.
LLM_FALLBACK_PROVIDER=anthropic
LLM_TIMEOUT_SECONDS=120
# Only used when LLM_PROVIDER or LLM_FALLBACK_PROVIDER is "openai".
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=qwen3:32b
OPENAI_COMPAT_VISION_MODEL=qwen2.5vl:32b

# Shared secret for the local worker, at least 32 characters: openssl rand -hex 32
# Put the same value in worker/.env on the computer that runs the worker.
LLM_WORKER_TOKEN=
# Where each background job type runs when a worker with its model is online: local or cloud.
# Scoring stays in the cloud until the local model passes the accuracy benchmark.
LLM_ROUTE_TRANSCRIBE=local
LLM_ROUTE_SCORE=cloud
# Models the worker must have pulled in Ollama. Reading pages needs a vision model.
LLM_LOCAL_MODEL_TRANSCRIBE=qwen2.5vl:32b
LLM_LOCAL_MODEL_SCORE=qwen3:32b
# A local job not finished after this many seconds runs in the cloud instead.
LLM_LOCAL_TIMEOUT_SECONDS=600
# At most this many jobs wait for the worker at once; more go straight to the cloud.
LLM_LOCAL_MAX_QUEUE=5
# How long a worker may hold a job without checking in before the cloud takes it.
LLM_LEASE_SECONDS=600
# A worker that has not checked in for this long counts as offline.
LLM_WORKER_STALE_SECONDS=90
# Comma-separated emails that can open /admin/llm (model costs and savings).
ADMIN_EMAILS=

# --- Background jobs -------------------------------------------------
# "inline" runs jobs inside the web process (local dev and tests). "inngest" uses Inngest.
JOBS_DRIVER=inline
# From the Inngest dashboard, when JOBS_DRIVER=inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
