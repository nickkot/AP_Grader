# Settings for the local model worker. Copy to worker/.env, fill in, then: chmod 600 worker/.env
# The worker never needs database credentials or a cloud API key.

# Your AP Grader site. Must be https:// (http only works for localhost while developing).
AP_GRADER_URL=https://apgrader.example.com

# The same value as LLM_WORKER_TOKEN on the server. Make one with: openssl rand -hex 32
LLM_WORKER_TOKEN=

# Ollama on this Mac. Leave it on 127.0.0.1: do not set OLLAMA_HOST=0.0.0.0.
OLLAMA_URL=http://127.0.0.1:11434

# Shown on the admin page. Defaults to this computer's name.
# WORKER_ID=nicks-macbook

# Jobs at once. Keep 1 unless Ollama runs with OLLAMA_NUM_PARALLEL above 1 and you have memory to spare.
WORKER_CONCURRENCY=1

# Seconds between asks for work when there is none.
POLL_SECONDS=5

# Longest one model call may take before the job goes back to the cloud.
JOB_TIMEOUT_SECONDS=900
